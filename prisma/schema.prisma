generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessRole {
  owner
  admin
}

enum ConversationStatus {
  open
  waiting
  human_required
  closed
}

enum Direction {
  inbound
  outbound
}

model Business {
  id                        String         @id @default(cuid())
  name                      String
  phoneNumber               String?
  whatsappPhoneNumberId     String?        @unique
  whatsappBusinessAccountId String?
  type                      String?
  description               String?
  address                   String?
  timezone                  String         @default("America/Costa_Rica")
  status                    String         @default("active")
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  users                     BusinessUser[]
  botConfig                 BotConfig?
  items                     BusinessItem[]
  customers                 Customer[]
  conversations             Conversation[]
}

model User {
  id         String         @id @default(cuid())
  name       String?
  email      String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  businesses BusinessUser[]
}

model BusinessUser {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole @default(owner)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([userId, businessId])
  @@index([businessId])
}

model BotConfig {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  systemInstructions  String   @default("")
  tone                String   @default("amable y breve")
  welcomeMessage      String
  fallbackMessage     String
  humanHandoffMessage String
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessItem {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  category    String?
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("CRC")
  available   Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, available])
}

model Customer {
  id             String         @id @default(cuid())
  businessId     String
  whatsappNumber String
  name           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  @@unique([businessId, whatsappNumber])
  @@index([businessId])
}

model Conversation {
  id              String             @id @default(cuid())
  businessId      String
  customerId      String
  status          ConversationStatus @default(open)
  priority        Int                @default(0)
  assignedToHuman Boolean            @default(false)
  lastMessageAt   DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages        Message[]
  @@index([businessId, status, lastMessageAt])
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  direction         Direction
  messageType       String       @default("text")
  content           String
  whatsappMessageId String?      @unique
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  businessId  String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  status      String    @default("received")
}
